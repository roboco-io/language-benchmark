POST    /api/users/login                 controllers.UserController.login
POST    /api/users                       controllers.UserController.register
GET     /api/user                        controllers.UserController.current
PUT     /api/user                        controllers.UserController.update

GET     /api/profiles/:username          controllers.ProfileController.get(username)
POST    /api/profiles/:username/follow   controllers.ProfileController.follow(username)
DELETE  /api/profiles/:username/follow   controllers.ProfileController.unfollow(username)

GET     /api/articles/feed               controllers.ArticleController.feed
GET     /api/articles                    controllers.ArticleController.list
POST    /api/articles                    controllers.ArticleController.create
GET     /api/articles/:slug              controllers.ArticleController.get(slug)
PUT     /api/articles/:slug              controllers.ArticleController.update(slug)
DELETE  /api/articles/:slug              controllers.ArticleController.delete(slug)
POST    /api/articles/:slug/favorite     controllers.ArticleController.favorite(slug)
DELETE  /api/articles/:slug/favorite     controllers.ArticleController.unfavorite(slug)

GET     /api/articles/:slug/comments     controllers.CommentController.list(slug)
POST    /api/articles/:slug/comments     controllers.CommentController.add(slug)
DELETE  /api/articles/:slug/comments/:id controllers.CommentController.delete(slug, id: Long)

GET     /api/tags                        controllers.TagController.list
