# probe(앱 태스크 사이드카)와 runner(부하 태스크)가 함께 쓰는 도구 이미지. linux/arm64.
FROM python:3.12-slim
ARG K6_VERSION=v1.1.0
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && curl -fsSL "https://github.com/grafana/k6/releases/download/${K6_VERSION}/k6-${K6_VERSION}-linux-arm64.tar.gz" \
    | tar -xz -C /tmp && mv /tmp/k6-${K6_VERSION}-linux-arm64/k6 /usr/local/bin/k6 \
 && pip install --no-cache-dir boto3==1.43.2 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY probe.py runner.sh seed.py load.js /opt/lb/
CMD ["bash", "/opt/lb/runner.sh"]
