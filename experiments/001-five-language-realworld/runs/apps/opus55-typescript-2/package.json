{
  "name": "realworld-fastify-prisma",
  "version": "1.0.0",
  "private": true,
  "description": "RealWorld (Conduit) backend API built with Fastify, Prisma and SQLite",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:api": "bash api/run-api-tests-hurl.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
