APP_NAME=RealWorld
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite

BCRYPT_ROUNDS=10
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null

# Secret used to sign JWTs; falls back to APP_KEY when empty.
JWT_SECRET=
# JWT lifetime in seconds.
JWT_TTL=86400

OCTANE_SERVER=frankenphp
