# 언어 벤치마크 설정 — setup.sh가 $HOME/experiments/langbench-exp$EXP/bench.env로 복사해 고정한다.
EXP=901                       # 실험 번호 (3자리)
HARNESS=claude-native         # claude-native만 지원 (구독 인증 강제)
# 조건 목록: "<조건명>:<모델 ID>" 공백 구분. 조건명에는 '-' 금지 (run 이름 <조건>-<언어>-<n> 파싱용)
CONDITIONS="sonnet55:claude-sonnet-5-5 opus55:claude-opus-5-5"
LANGS="typescript python go rust cpp"   # scripts/metrics.py의 LANGUAGES와 같은 순서·철자
N=3                           # 조건×언어당 반복 수
MAX_ITER=30                   # iteration 상한
MAX_SEC=1200                  # run당 wall-clock 상한(초). iteration 도중에도 적용 — 도달 시 진행 중 iteration 종료(exit 125)
STALL_SEC=300                 # iteration 정체 한도(초). 세션 기록·실행 로그·앱 파일이 이 시간 동안 갱신되지 않으면 iteration 종료(exit 124)
START_SEC=600                 # 앱 기동 대기 한도(초)
DOCKER_BUILD_SEC=900          # docker build 한도(초)
FU_MAX_ITER=5                 # 후속 과제 iteration 상한
FU_MAX_SEC=1200               # 후속 과제 run당 wall-clock 상한(초)
# 비용 상한 (필수). setup·smoke가 미설정이면 거부한다. 진행 중 30초마다 cost_guard.py로 추정해 넘으면 iteration을 종료(exit 126)한다.
MODEL_SPECS=""                # 필수: 모델별 입력 한도·최대 출력·과금 체계 JSON. 형식은 scripts/preflight.py 주석, 예시 assets/model-specs.example.json
# 아래 PRICE_*는 model-specs.json에 pricing이 없을 때만 쓰는 예비값
PRICE_IN=""                   # 100만 토큰당 입력 단가(USD). 구독 실행은 0
PRICE_OUT=""                  # 100만 토큰당 출력 단가(USD). 구독 실행은 0
PRICE_CACHE_READ=""           # 캐시 읽기 단가. 빈 값이면 입력 단가의 10%
PRICE_TIERS=""                # 입력 길이 구간 단가 "상한:입력:출력,..."
RUN_BUDGET_USD=2              # run 1개 추정 비용 상한
EXP_BUDGET_USD=10             # 실험 전체 추정 비용 상한 (설계 문서에 사전 등록하고 사용자 승인)
